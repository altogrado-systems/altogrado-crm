# ── Cliente (Vite) — VITE_* se incluye en el bundle del navegador
# Restringe VITE_MAPS_KEY por dominio en Google Cloud (HTTP referrers)
VITE_MAPS_KEY=tu_api_key_maps

# ── Solo servidor (Vercel → Settings → Environment Variables)
# NO uses prefijo VITE_ para secretos
# IMPORTANTE: GOOGLE_API_KEY debe ser una key DIFERENTE a VITE_MAPS_KEY
# En Google Cloud → Credentials → API key → Application restrictions: NONE
# API restrictions: solo "Google Sheets API" (sin restricción HTTP referrer)
GOOGLE_API_KEY=tu_api_key_solo_servidor_sheets
GOOGLE_SHEET_ID=tu_sheet_id
MAKE_WEBHOOK_E5=https://hook.us2.make.com/...
MAKE_WEBHOOK_E7=https://hook.us2.make.com/...
MAKE_WEBHOOK_RESULT=https://hook.eu1.make.com/...
